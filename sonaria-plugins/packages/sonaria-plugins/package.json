{
  "name": "sonaria-plugins",
  "version": "0.1.0",
  "description": "All-in-one plugin suite for Sonaria: Deezer, YouTube, SoundCloud, Spotify and Apple Music with mirror fallback.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external --sourcemap=external",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "keywords": ["sonaria", "seyfert", "discord", "music", "plugins", "deezer", "youtube", "soundcloud", "spotify", "applemusic"],
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "sonaria-plugin-applemusic": "*",
    "sonaria-plugin-core": "*",
    "sonaria-plugin-deezer": "*",
    "sonaria-plugin-soundcloud": "*",
    "sonaria-plugin-spotify": "*",
    "sonaria-plugin-youtube": "*"
  },
  "peerDependencies": {
    "sonaria": "^0.2.0"
  }
}
