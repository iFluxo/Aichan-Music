{
  "name": "sonaria-plugin-applemusic",
  "version": "0.1.0",
  "description": "Apple Music info plugin for Sonaria. Resolves Apple Music links with the iTunes API or the web page data and keeps Apple Music metadata while playback is mirrored to Deezer/YouTube/SoundCloud.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external --sourcemap=external",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "keywords": ["sonaria", "seyfert", "discord", "music", "apple", "applemusic", "itunes", "plugin"],
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "sonaria-plugin-core": "*"
  },
  "peerDependencies": {
    "sonaria": "^0.2.0"
  }
}
