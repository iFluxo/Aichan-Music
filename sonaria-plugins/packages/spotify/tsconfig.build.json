{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    // Builds consume the compiled dist output of workspace packages instead
    // of their sources, so each package can be published on its own.
    "paths": {},
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"]
}
