{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["bun", "node"],

        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,

        "noUnusedLocals": true,
        "noUnusedParameters": true,

        "esModuleInterop": true,
        "resolveJsonModule": true,
        "preserveSymlinks": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,

        "skipLibCheck": true,
        "noErrorTruncation": true,

        "rootDir": ".",
        "outDir": "./dist",

        "paths": {
            "app/*": ["./app/*"],
            "#function": ["./app/utils/function.ts"],
            "#config": ["./assets/config.ts"],
            "sonaria-plugins": [
                "./sonaria-plugins/packages/sonaria-plugins/src/index"
            ],
            "sonaria-plugin-core": [
                "./sonaria-plugins/packages/core/src/index"
            ],
            "sonaria-plugin-youtube": [
                "./sonaria-plugins/packages/youtube/src/index"
            ],
            "sonaria-plugin-deezer": [
                "./sonaria-plugins/packages/deezer/src/index"
            ],
            "sonaria-plugin-soundcloud": [
                "./sonaria-plugins/packages/soundcloud/src/index"
            ],
            "sonaria-plugin-spotify": [
                "./sonaria-plugins/packages/spotify/src/index"
            ],
            "sonaria-plugin-applemusic": [
                "./sonaria-plugins/packages/applemusic/src/index"
            ]
        }
    },

    "include": ["app/**/*", "assets/*", "scripts/*"],
    "exclude": ["node_modules", "dist"]
}
